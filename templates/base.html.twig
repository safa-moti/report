<!DOCTYPE html>
<html lang="sv">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}🌈 Welcome to the Crazy Symfony Site! 🌟
			{% endblock %}
		</title>

		<link rel="icon" href="{{ asset('img/glider.svg') }}">

		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>

		<header class="site-header" style="background-image: url({{ asset('img/background.jpg') }}); background-size: cover; padding: 20px; text-align: center;">
			<h1 class="site-title" style="font-size: 3rem; color: #fff; text-shadow: 3px 3px 0 #000;">🎉 My Symfony Playground 🎨</h1>
		</header>

		<nav style="background: linear-gradient(45deg, #ff00cc, #3333ff); padding: 15px;">
			<ul style="display: flex; gap: 15px; list-style: none; justify-content: center; font-size: 1.2rem;">
				<li>
					 <a href="{{ path('home') }}" style="color: yellow;">🏠 Home</a>
				</li>
				<li>
					 <a href="{{ path('about') }}" style="color: lime;">📘 About</a>
				</li>
				<li>
					 <a href="{{ path('me') }}" style="color: cyan;">🧑‍💻 Me</a>
				</li>
				<li>
					 <a href="{{ path('report') }}" style="color: orange;">📝 Report</a>
				</li>
				<li>
					 <a href="{{ path('api_home') }}" style="color: lightgreen;">🔗 API</a>
				</li>
				<li>
					 <a href="{{ path('lucky') }}" style="color: pink;">🎲 Lucky</a>
				</li>
				<li>
					 <a href="{{ path('pig_start') }}" style="color: pink;"> Pig Game</a>
				</li>
				<li>
					 <a href="{{ path('pig_init_get') }}" style="color: pink;"> Pig Game(Init)</a>
				</li>
				<li>
				     <a href="{{ path('card_home') }}" style="color: lightblue;">Kortspel</a>
				</li>
				<li>
					 <a href="{{ path('card_deck') }}" style="color: lightblue;">Deck of Cards</a>
				</li>
				<li>
					 <a href="{{ path('card_deck_shuffle') }}" style="color: orange;">Shuffle Cards</a>
				</li>
				<li>
					 <a href="{{ path('card_deck_draw') }}" style="color: pink;">Draw a Card</a>
				</li>
				<li>
					 <a href="{{ path('card_deck_draw_number', { 'number': 5 }) }}" style="color: lime;">Draw 5 Cards</a>
				</li>
				<li>
					 <a href="{{ path('card_deck_deal', { 'players': 2, 'cards': 5 }) }}" style="color: lightblue;">Deal Cards</a>
				</li>

				<!-- Added Game-related Routes -->
				<li>
					 <a href="{{ path('game_home') }}" style="color: lightcoral;">🎮 Game Home</a>
				</li>
				<li>
					 <a href="{{ path('game_doc') }}" style="color: lightgreen;">📜 Game Docs</a>
				</li>
				<li>
					 <a href="{{ path('game_play') }}" style="color: yellowgreen;">🎲 Play Game</a>
				</li>
				<li>
					 <a href="{{ path('game_draw') }}" style="color: orange;">🃏 Draw Card</a>
				</li>
				<li>
					 <a href="{{ path('game_dealer_turn') }}" style="color: dodgerblue;">🃏 Dealer Turn</a>
				</li>
			</ul>
		</nav>

		<main style="padding: 2rem; background: rgba(255, 255, 255, 0.7); margin: 1rem; border-radius: 1rem;"> 
			{% block body %}{% endblock %}
		</main>

		<footer style="text-align: center; margin-top: 2rem; color: #fff; background-color: #222; padding: 1rem;">
			💥 Built with ❤️ in Symfony - 
			{{ "now"|date("Y") }}
		</footer>

	</body>
</html>
