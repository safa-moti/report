{% extends 'base.html.twig' %}

{% block title %}API-översikt
{% endblock %}

{% block body %}
	<h1>API-översikt</h1>

	<p>Här är alla tillgängliga API-rutter:</p>

	<ul>
		<li>
			<a href="{{ path('api_deck') }}">GET /api/deck</a>
			– Visa hela kortleken i JSON-format</li>
		<li>
			<a href="{{ path('api_deck_shuffle') }}">GET /api/deck/shuffle</a>
			– Blanda kortleken</li>
		<li>
			<a href="{{ path('api_deck_draw') }}">GET /api/deck/draw</a>
			– Dra ett kort</li>
		<li>
			<a href="{{ path('api_deck_draw_number', {number: 3}) }}">GET /api/deck/draw/{number}</a>
			– Dra flera kort</li>
		<li>
			<a href="{{ path('api_game') }}">GET /api/game</a>
			– Visa aktuell ställning för spelet 21</li>
	</ul>

	<p>Alla dessa endpoints returnerar JSON-data som kan användas av andra system eller för testning via t.ex. Postman.</p>
{% endblock %}
