{% extends 'base.html.twig' %}

{% block title %}Play Game
{% endblock %}

{% block body %}
	<h1>Game Play</h1>

	<h2>Your Hand</h2>
	<ul>
		{% for card in player_hand %}
			<li>{{ card }}</li>
		{% endfor %}
	</ul>
	<p>
		<strong>Your Score:</strong>
		{{ player_score }}</p>

	<h2>Dealer's Hand</h2>
	<ul>
		{% for card in dealer_hand %}
			<li>{{ card }}</li>
		{% endfor %}
	</ul>
	<p>
		<strong>Dealer's Score:</strong>
		{{ dealer_score }}</p>

	<p>
		<a href="{{ path('game_draw') }}">Draw a card</a>
	</p>

	<p>
		<a href="{{ path('game_dealer_turn') }}">Dealer's Turn</a>
	</p>
{% endblock %}
