{% extends 'base.html.twig' %}

{% block title %}Blanda Kortleken{% endblock %}

{% block body %}
    <h1>Blandad Kortlek</h1>

    <p>Korten har blandats. Här är kortleken:</p>

    <ul>
        {% for card in cards %}
            <li>{{ card }}</li>
        {% endfor %}
    </ul>

    <a href="{{ path('card_deck') }}">Visa alla kort</a>
    <a href="{{ path('card_deck_draw') }}">Dra ett kort</a>
{% endblock %}
