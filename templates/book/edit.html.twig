{% extends 'base.html.twig' %}

{% block title %}Redigera Bok:
	{{ book.title }}
{% endblock %}

{% block body %}
	<h1>Redigera Bok:
		{{ book.title }}</h1>

	<form action="{{ path('book_update', {'id': book.id}) }}" method="POST">
		<div>
			<label for="title">Titel:</label>
			<input type="text" id="title" name="title" value="{{ book.title }}" required/>
		</div>
		<div>
			<label for="isbn">ISBN:</label>
			<input type="text" id="isbn" name="isbn" value="{{ book.isbn }}" required/>
		</div>
		<div>
			<label for="author">Författare:</label>
			<input type="text" id="author" name="author" value="{{ book.author }}" required/>
		</div>
		<div>
			<label for="image">Bild URL:</label>
			<input type="text" id="image" name="image" value="{{ book.image }}"/>
		</div>
		<div>
			<button type="submit">Uppdatera Bok</button>
		</div>
	</form>

	<a href="{{ path('book_show_all') }}">Tillbaka till listan</a>
{% endblock %}
