{% extends 'base.html.twig' %}

{% block title %}Bibliotek - Välkommen
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
		h1 {
			font-size: 2em;
			margin-bottom: 1em;
		}
		ul {
			list-style-type: none;
			padding: 0;
		}
		ul li {
			margin-bottom: 10px;
		}
	</style>

	<div class="example-wrapper">
		<h1>Välkommen till ditt bibliotek! 📚</h1>

		<p>Här kan du hantera dina böcker.</p>

		<ul>
			<li>
				<a href="{{ path('book_show_all') }}">Visa alla böcker</a>
			</li>
			<li>
				<a href="{{ path('book_create') }}">Skapa en ny bok</a>
			</li>
			<li>
				<a href="{{ path('book_reset') }}">Återställ biblioteket</a>
			</li>
		</ul>

		<h2>Senaste åtgärder:</h2>
		<ul>
			<li>Se alla böcker:
				<code>{{ path('book_show_all') }}</code>
			</li>
			<li>Skapa en ny bok:
				<code>{{ path('book_create') }}</code>
			</li>
			<li>Återställ biblioteket:
				<code>{{ path('book_reset') }}</code>
			</li>
		</ul>

		<h2>Bilder på böcker</h2>

		<img src="{{ asset('images/1984.jpg') }}" alt="1984 Book Cover" width="200"/>


		<img src="{{ asset('images/prideandprjudice.jpg') }}" alt="Pride and Prejudice Book Cover" width="200"/>


		<img src="{{ asset('images/mobydick.jpg') }}" alt="Moby Dick Book Cover" width="200"/>
	</div>
{% endblock %}
